generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  idInstitucional        String       @id @map("id_institucional")
  rol                    Rol
  estado                 Estado       @default(activo)
  password               String
  asistenciasRegistradas Asistencia[] @relation("RegistradoPor")
  reservas               Reserva[]
  suspensiones           Suspension[]
  suspensionesLevantadas Suspension[] @relation("LevantadaPor")

  @@map("usuario")
}

model PlantillaFranja {
  id              String    @id @default(uuid())
  diaSemana       DiaSemana
  horaInicio      String
  horaFin         String
  capacidadMaxima Int
  activa          Boolean   @default(true)
  franjas         Franja[]

  @@map("plantilla_franja")
}

model Franja {
  id               String          @id @default(uuid())
  idPlantilla      String
  fecha            DateTime        @db.Date
  semestre         String
  cuposDisponibles Int
  plantilla        PlantillaFranja @relation(fields: [idPlantilla], references: [id])
  reservas         Reserva[]

  @@map("franja")
}

model Reserva {
  id            String        @id @default(uuid())
  idUsuario     String
  idFranja      String
  fechaCreacion DateTime      @default(now())
  estado        EstadoReserva @default(activa)
  asistencia    Asistencia?
  franja        Franja        @relation(fields: [idFranja], references: [id])
  usuario       Usuario       @relation(fields: [idUsuario], references: [idInstitucional])

  @@map("reserva")
}

model Asistencia {
  id            String    @id @default(uuid())
  idReserva     String    @unique
  registradoPor String
  resultado     Resultado
  registradoEn  DateTime  @default(now())
  reserva       Reserva   @relation(fields: [idReserva], references: [id])
  admin         Usuario   @relation("RegistradoPor", fields: [registradoPor], references: [idInstitucional])

  @@map("asistencia")
}

model Suspension {
  id           String   @id @default(uuid())
  idUsuario    String
  levantadaPor String?
  fechaInicio  DateTime
  fechaFin     DateTime
  motivo       String
  activa       Boolean  @default(true)
  usuario      Usuario  @relation(fields: [idUsuario], references: [idInstitucional])
  admin        Usuario? @relation("LevantadaPor", fields: [levantadaPor], references: [idInstitucional])

  @@map("suspension")
}

model Configuracion {
  clave       String @id
  valor       String
  descripcion String

  @@map("configuracion")
}

model AuditLog {
  id         String   @id @default(uuid())
  accion     String
  entidad    String
  idEntidad  String?
  detalle    String?
  idUsuario  String
  creadoEn   DateTime @default(now())

  @@map("audit_log")
}

enum Rol {
  estudiante
  administrador
}

enum Estado {
  activo
  suspendido
}

enum DiaSemana {
  lunes
  martes
  miercoles
  jueves
  viernes
}

enum EstadoReserva {
  activa
  cancelada
  completada
  no_show
}

enum Resultado {
  presente
  no_show
}
