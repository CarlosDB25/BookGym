{
  "name": "bookgym",
  "version": "1.0.0",
  "private": true,
  "description": "Sistema de reservas para gimnasio universitario",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev:backend": "npm --workspace backend run dev",
    "dev:frontend": "npm --workspace frontend run dev",
    "build:frontend": "npm --workspace frontend run build",
    "start:backend": "npm --workspace backend run start",
    "seed": "npm --workspace backend run seed",
    "test:e2e": "npm --workspace frontend run test:e2e",
    "prisma:generate": "npm --workspace backend run prisma:generate",
    "prisma:push": "npm --workspace backend exec prisma db push"
  },
  "keywords": [
    "gimnasio",
    "reservas",
    "universitario"
  ],
  "license": "ISC"
}
